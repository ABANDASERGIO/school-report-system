# Database
DATABASE_URL="postgresql://user:password@localhost:5432/edugrade?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=dev-access-secret-replace-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-replace-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
FRONTEND_URL=http://localhost:3000
